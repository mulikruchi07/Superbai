rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// Tighten owner-only access after validating all client query paths.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /User/{userId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /TestUser/{userId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /maids/{maidId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    match /Appointments/{appointmentId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /Transaction/{transactionId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /Complaint/{complaintId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /Review/{reviewId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /FACT_BOOKINGS/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /DIM_USERS/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /DIM_SERVICES/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /DIM_TIME_SLOTS/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /DIM_SALARY/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // OTP records must not be readable or writable from the client.
    match /OTPs/{otpId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
